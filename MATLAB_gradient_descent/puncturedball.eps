{{
/RawData currentfile /ASCII85Decode filter def
/Data RawData /FlateDecode filter def
/DeviceRGB setcolorspace
<<
  /ImageType 1
  /Decode [0 1 0 1 0 1]
  /DataSource Data
  /Height 253
  /ImageMatrix [321 0 0 253 0 0]
  /Width 321
  /BitsPerComponent 8
>> image
} stopped {handleerror} if
  RawData flushfile
} exec
